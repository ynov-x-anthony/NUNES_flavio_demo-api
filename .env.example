# Copier ce fichier en .env (non commite) puis adapter les valeurs :
#   cp .env.example .env
#
# Ces variables servent a l'interpolation ${} de compose.yml.
# Le mot de passe de la base n'est PAS ici : il passe par Docker Secrets
# (fichier secrets/db_password.txt, voir README.md).

# Utilisateur et base PostgreSQL (crees au premier demarrage)
POSTGRES_USER=demo
POSTGRES_DB=demo

# Port de l'hote pour l'API (http://localhost:API_PORT)
API_PORT=8080

# Port de l'hote pour Adminer (http://localhost:ADMINER_PORT)
ADMINER_PORT=8081

# Images publiees par la CI (utilisees par "docker compose pull" au deploiement).
# En local, "docker compose up -d --build" construit ces memes noms d'image.
IMAGE_PREFIX=ghcr.io/ynov-x-anthony/nunes_flavio_demo-api
TAG=latest
