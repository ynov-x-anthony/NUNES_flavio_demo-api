# syntax=docker/dockerfile:1
# Base epinglee et rafraichie regulierement (scan Trivy en CI).
ARG NODE_IMAGE=node:22.11-alpine3.20

FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc npm ci --omit=dev

FROM ${NODE_IMAGE} AS runtime
# Correctifs OS publies depuis la sortie du tag de base, et suppression de
# npm/npx/corepack : inutiles a l'execution, ils embarquent leurs propres CVE.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /app
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node server.js db.js package.json ./
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
USER node
EXPOSE 3000
CMD ["node", "server.js"]
